# IFA Confluence
CONFLUENCE_BASE_URL=https://devstack.vwgroup.com/confluence
CONFLUENCE_SITE_URL=https://devstack.vwgroup.com/confluence
CONFLUENCE_SPACE_KEY=IFA
CONFLUENCE_ROOT_PAGE_ID=94450529

# Authentication to Confluence: pat | basic | bearer | cookie | none
# Data Center PATs normally use Authorization: Bearer <token>.
CONFLUENCE_AUTH_MODE=pat
CONFLUENCE_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
CONFLUENCE_COOKIE=

# Optional extra request headers as a JSON object, for an internal gateway only.
CONFLUENCE_EXTRA_HEADERS_JSON={}

# Optional outbound mTLS / internal CA
CONFLUENCE_CLIENT_CERT_PATH=
CONFLUENCE_CLIENT_KEY_PATH=
CONFLUENCE_CLIENT_KEY_PASSPHRASE=
CONFLUENCE_CA_CERT_PATH=
CONFLUENCE_TLS_INSECURE_SKIP_VERIFY=false

# Request/output safety limits
CONFLUENCE_REQUEST_TIMEOUT_MS=30000
CONFLUENCE_MAX_RESPONSE_BYTES=20971520
MCP_MAX_CONTENT_CHARS=120000
MCP_MAX_RESULTS=50

# MCP transport: stdio | http
MCP_TRANSPORT=stdio

# HTTP transport settings
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
# Required when binding to a non-loopback host unless MCP_ALLOW_INSECURE_HTTP=true.
MCP_HTTP_AUTH_TOKEN=
MCP_ALLOW_INSECURE_HTTP=false
# Required for 0.0.0.0/non-loopback hosting. Comma-separated hostnames, without ports.
MCP_HTTP_ALLOWED_HOSTS=
MCP_HTTP_ALLOWED_ORIGINS=

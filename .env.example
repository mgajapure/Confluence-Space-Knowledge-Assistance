# API base URL.
# Classic/unscoped token example:
#   https://your-company.atlassian.net
# Scoped token example:
#   https://api.atlassian.com/ex/confluence/YOUR_CLOUD_ID
CONFLUENCE_API_BASE_URL=https://your-company.atlassian.net

# Human-facing site URL used to build source links in exported records.
CONFLUENCE_SITE_URL=https://your-company.atlassian.net

CONFLUENCE_EMAIL=your.email@company.com
CONFLUENCE_API_TOKEN=replace_me
CONFLUENCE_SPACE_KEY=IFA

# Output controls
OUTPUT_DIR=confluence-export
CLEAN_OUTPUT=true
DOWNLOAD_ATTACHMENTS=true
EXTRACT_ATTACHMENT_TEXT=true
INCLUDE_COMMENTS=true
INCLUDE_BLOG_POSTS=true

# AI chunking controls
CHUNK_SIZE_TOKENS=900
CHUNK_OVERLAP_TOKENS=120
